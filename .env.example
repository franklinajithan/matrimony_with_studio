# Public client config (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Canonical site origin used in auth redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# Server-only. Never put this in NEXT_PUBLIC_ variables or Vercel "browser" env.
# IPv4 session pooler URI, used only by local schema/migration scripts.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres
